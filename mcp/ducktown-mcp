#!/usr/bin/env python3
"""DuckTown MCP server — an AI agent's hands and eyes inside a FiveM server.

A stdio MCP server. Every tool shells out (over SSH, or locally) to the
`fivem-admin` CLI on the server host, which talks to the token-gated
juno-admin API inside the FiveM server.

Access control: this is built for the server owner's own agents only. There
is NO network listener — stdio only. The game-side API token never leaves the
server host (fivem-admin reads it locally there), and reaching the host at
all requires the owner's SSH key. In-game players have no path to any of this.

Transport: env DUCKTOWN_SSH sets the command prefix used to reach the host.
  - Agent on another machine:  DUCKTOWN_SSH="ssh -i ~/.ssh/id_ed25519 user@your-server-host"
  - Agent on the server host itself: leave it unset (tools run locally).
"""
import json
import os
import shlex
import subprocess
import sys
import time

SSH_PREFIX = shlex.split(os.environ["DUCKTOWN_SSH"]) if os.environ.get("DUCKTOWN_SSH") else ["sh", "-c"]
REMOTE = "~/bin/fivem-admin"


def run_admin(*args):
    remote_cmd = REMOTE + " " + " ".join(shlex.quote(str(a)) for a in args)
    proc = subprocess.run(SSH_PREFIX + [remote_cmd], capture_output=True, text=True, timeout=30)
    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()
    if proc.returncode != 0:
        return (out + "\n" + err).strip() or f"fivem-admin exited {proc.returncode}"
    return out or "(no output)"


def tool_result(text, is_error=False):
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def sense_companion(player):
    """Run sense and return just the companion block (mode/distance/inVehicle)."""
    raw = run_admin("sense", player)
    try:
        data = json.loads(raw)
        sense = data.get("sense") or data
        comp = sense.get("companion")
        if comp is None:
            return "(companion not present in sense report)"
        return json.dumps(comp, indent=2)
    except Exception:  # noqa: BLE001 - fall back to the raw report
        return raw


DEFAULT_WEAPONS = ["carbine", "pistol"]


def arm_player(player, weapons=None):
    """Composite: arm a player with the given inventory weapon items
    (default: carbine + pistol) — via the framework INVENTORY route (give
    verb -> bs_inventory GiveItem, one call per item). NOT giveweapon: the
    inventory sync strips any weapon a player holds that is not in their
    inventory, so client-given weapons vanish from players within
    moments."""
    items = weapons or DEFAULT_WEAPONS
    return "\n".join(f"{item}: {run_admin('give', player, item, 1)}" for item in items)


def companion_deploy(player):
    """Composite: spawn the companion beside the player, put her on guard
    (armed, carbine in hand), then read back her sense state. The short waits
    matter: the ped spawns asynchronously on the player's client, so a guard
    order sent too early lands before she exists and is dropped."""
    spawn = run_admin("companion", player, "spawn")
    time.sleep(2)
    guard = run_admin("companion", player, "guard")
    time.sleep(1)
    comp = sense_companion(player)
    return f"spawn: {spawn}\nguard: {guard}\ncompanion: {comp}"


def kit(player, vehicle=None, weapons=None):
    """Composite: the respawn kit in one call, parameterized — nothing is
    hard-stuck to one car, one gun, or one shape. With a vehicle: spawn it
    and seat the player, spawn the companion and warp her into the passenger
    seat (ride — she cannot be stranded at the curb), arm the player, final
    sense report to verify all of it. Without a vehicle: the companion
    deploys on foot (spawn + guard) and the player is armed, then the same
    sense verification."""
    if not vehicle:
        steps = [("companion deploy", companion_deploy(player))]
        steps.append(("arm player", arm_player(player, weapons)))
        steps.append(("sense", run_admin("sense", player)))
        return "\n".join(f"{k}: {v}" for k, v in steps)
    steps = [("spawnveh", run_admin("spawnveh", player, vehicle, -1))]
    steps.append(("companion spawn", run_admin("companion", player, "spawn")))
    time.sleep(2)
    steps.append(("companion ride", run_admin("companion", player, "ride")))
    steps.append(("arm player", arm_player(player, weapons)))
    steps.append(("sense", run_admin("sense", player)))
    return "\n".join(f"{k}: {v}" for k, v in steps)


