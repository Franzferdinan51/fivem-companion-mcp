TOOL_MAP = {t["name"]: t for t in TOOLS}


def handle(msg):
    method = msg.get("method", "")
    mid = msg.get("id")
    if method == "initialize":
        return {"jsonrpc": "2.0", "id": mid, "result": {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "ducktown", "version": "1.0.0"},
        }}
    if method == "ping":
        return {"jsonrpc": "2.0", "id": mid, "result": {}}
    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": mid, "result": {
            "tools": [{k: t[k] for k in ("name", "description", "inputSchema")} for t in TOOLS]}}
    if method == "tools/call":
        params = msg.get("params", {})
        tool = TOOL_MAP.get(params.get("name", ""))
        if not tool:
            return {"jsonrpc": "2.0", "id": mid, "result": tool_result("unknown tool", True)}
        try:
            text = tool["run"](params.get("arguments", {}) or {})
            return {"jsonrpc": "2.0", "id": mid, "result": tool_result(text)}
        except Exception as e:  # noqa: BLE001 - report, never crash the server
            return {"jsonrpc": "2.0", "id": mid, "result": tool_result(f"error: {e}", True)}
    if mid is not None:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {method}"}}
    return None  # notification


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        resp = handle(msg)
        if resp is not None:
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
